# 配置模板：包含 Windows 宿主机和 Docker Compose 使用的配置。
# 首次配置时可复制为 .env，再填写本机实际值；已有 .env 时请逐项核对。
# .env.example 只放示例；真实 API Key 和数据库密码放在 .env 中。
# 创建此文件不会自动加载配置，仍需使用 README 中加载 .env 的启动命令。
# Compose 使用容器专用数据库连接串，并映射模型缓存的容器内路径。

# DeepSeek API 密钥：FAQ 生成回答时使用。
# 模板留空；需要 FAQ 生成回答时填写 Key，纯检索与模拟业务查询可不填。
DEEPSEEK_API_KEY=

# DeepSeek 生成模型名称：沿用当前代码和 README 中的配置。
# 这是生成答案的模型；本地 BGE 模型负责把文本转换成向量。
DEEPSEEK_MODEL=deepseek-flash

# PostgreSQL 连接串：FAQ 入库和检索共用。
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 用户名、端口和数据库名沿用 README 示例，需核对实际数据库配置。
# replace_with_local_password 是占位符，使用时替换为实际数据库密码。
# 当前 API 在 Windows 上运行，通过宿主机的 127.0.0.1:5432 访问数据库。
# API 进入容器后，127.0.0.1 指向 API 容器自身；需改用数据库服务名。
DATABASE_URL=postgresql://rag:replace_with_local_password@127.0.0.1:5432/ragdb

# 容器专用连接串：同一 Compose 网络内通过数据库服务名 db 访问。
# 从实际 DATABASE_URL 复制，仅将主机 127.0.0.1 改为 db，保留原密码编码。
# Compose 将这个值注入 API 容器的 DATABASE_URL；应用代码无需增加配置读取。
DATABASE_URL_DOCKER=postgresql://rag:replace_with_local_password@db:5432/ragdb

# 本地 BGE 模型缓存目录：供 FAQ 入库脚本和 API 检索使用。
# 下面是 Windows 宿主机路径示例，需核对本机实际缓存位置。
# API 只读取本地模型文件，需要预先准备完整模型缓存。
# 此项始终填写宿主机路径；Compose 挂载到 /models/hub，并覆盖容器环境变量。
HF_HUB_CACHE=D:/zuoye/huggingface/hub

# 以下是 Compose 数据库服务新增的配置。
# 填写现有 rag 用户的实际数据库密码，与 DATABASE_URL 中的密码一致。
# 已有数据目录中的账号密码不会因为修改这个变量而自动改变。
# 模板留空；后续在实际 .env 中补充此项，保留原有配置。
POSTGRES_PASSWORD=
# LangSmith 脱敏追踪（可选）：真实值只填入本机 .env。
# 启用后上传生成的请求编号、阶段耗时、固定原因码及 FAQ 规则 ID。
# 不上传问题/答案/证据原文、订单号、退款单号或 API Key。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 组织级 Key 如要求工作区标识，再填写；个人 Key 通常可留空。
LANGSMITH_WORKSPACE_ID=
