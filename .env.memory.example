# Copy to .env.memory; never commit it. This file is separate from the old .env.
# Use a long HEX/alphanumeric password so it is safe in the Compose database URL.
POSTGRES_PASSWORD=
DATABASE_URL=
MEMORY_API_KEY=
MEMORY_IMAGE=tracememory:v6-local
# Use the actual HTTPS OpenAI-compatible base URL for your region/workspace.
# The application appends /embeddings; do not include /embeddings here.
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIM=1024
MEMORY_PIPELINE_VERSION=v0
MEMORY_CHUNK_TARGET_BYTES=400
MEMORY_CHUNK_OVERLAP_BYTES=60
# Legacy *_TOKENS variables remain accepted when *_BYTES is absent.
# These are UTF-8 byte budgets, not provider tokenizer counts.
# vector baseline; hybrid, bm25, hybrid_bm25 are candidates requiring an ablation.
MEMORY_RETRIEVAL_MODE=vector
MEMORY_NEIGHBOR_WINDOW=0
MEMORY_SEED_LIMIT=20
# 0 = unlimited content bytes; entire slices are selected, never truncated.
MEMORY_EVIDENCE_BYTES=0
# Empty = disabled. Calibrate cosine gate on DEV only before enabling.
MEMORY_MIN_SIMILARITY=
# Optional source-linked contextual retrieval. New API requires migration 004/schema3.
# Production defaults stay off until an explicit candidate/config is deployed.
MEMORY_CONTEXTUAL_RETRIEVAL=0
MEMORY_CONTEXT_LIMIT=24
MEMORY_LINK_HOPS=2
MEMORY_SIGNAL_SCAN_LIMIT=5000
MEMORY_MAX_PAYLOAD_BYTES=8388608
MEMORY_MAX_CHUNKS_PER_ADD=20000
MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
MEMORY_PROBE_TTL_SECONDS=900
# Public DNS name (no scheme/path) for optional automatic HTTPS.
MEMORY_PUBLIC_HOST=
MEMORY_LOCAL_PORT=8000
