{
  "uid": "rag-stage4",
  "title": "RAG Stage 4 - Operations",
  "description": "Local simulated customer-service RAG: /ask and /v1/retrieve. Retrieval metrics exclude generation.",
  "schemaVersion": 39,
  "version": 2,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "rag",
    "stage4"
  ],
  "editable": false,
  "panels": [
    {
      "id": 13,
      "title": "Retrieval-only QPS",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "rag-prometheus"},
      "gridPos": {"x": 0, "y": 32, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "sum(rate(rag_http_requests_total{path=\"/v1/retrieve\",method=\"POST\"}[1m]))", "legendFormat": "completed QPS", "range": true}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 14,
      "title": "Retrieval-only P99",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "rag-prometheus"},
      "gridPos": {"x": 8, "y": 32, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(rag_http_request_duration_seconds_bucket{path=\"/v1/retrieve\",method=\"POST\"}[1m])))", "legendFormat": "P99", "range": true}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 15,
      "title": "Retrieval technical failure rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "rag-prometheus"},
      "gridPos": {"x": 16, "y": 32, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "sum(rate(rag_retrieve_outcomes_total{technical_failure=\"true\"}[1m])) / clamp_min(sum(rate(rag_retrieve_outcomes_total[1m])), 0.000001)", "legendFormat": "technical failure ratio", "range": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 1,
      "title": "API scrape",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rag-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"rag-api\"}",
          "legendFormat": "{{route}}{{reason}}{{stage}}{{status}}{{dependency}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ],
            "mode": "absolute"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
